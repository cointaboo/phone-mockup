{
  "manifest_version": 3,
  "name": "手机截图模拟器 - Phone Mockup",
  "version": "2.2.0",
  "description": "把任意网页变成手机截图：可一键切手机视图（真响应式布局），状态栏时间/运营商/5G/信号/WiFi/电量/充电全可改，套灵动岛/刘海/挖孔，截图自动加圆角阴影。",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "debugger"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "手机截图模拟器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
